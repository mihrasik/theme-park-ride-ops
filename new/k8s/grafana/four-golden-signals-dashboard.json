      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"ride-ops\",status=~\"4..\"}[5m]))",
          "legendFormat": "4xx Errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"ride-ops\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx Errors",
          "refId": "B"
