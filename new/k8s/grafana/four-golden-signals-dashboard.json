        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"ride-ops\"}[5m]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "title": "Traffic by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
